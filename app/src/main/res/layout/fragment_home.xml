<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6"
    tools:context=".Home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Judul -->
            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="Pemrograman Mobile"
                android:textColor="#6C5CE7"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Grid Tombol Pertemuan -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true">

                <!-- Pertemuan 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFourth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Pertemuan 4"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6C5CE7"
                    app:cornerRadius="30dp" />

                <!-- Pertemuan 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFifth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Pertemuan 5"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#8E7CC3"
                    app:cornerRadius="30dp" />

                <!-- Pertemuan 7 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToSeventh"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Pertemuan 7"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#B85285"
                    app:cornerRadius="30dp" />

                <!-- Pertemuan 10 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToTenth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Pertemuan 10"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D16B98"
                    app:cornerRadius="30dp" />

                <!-- Pertemuan 11 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToEleven"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:text="Pertemuan 11"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#F4B6C8"
                    app:cornerRadius="30dp" />

            </GridLayout>

            <!-- Cat Fact -->
            <TextView
                android:id="@+id/tvCatFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:padding="12dp"
                android:gravity="center"
                android:text="Loading cat fact..."
                android:textAlignment="center"
                android:textColor="#6C5CE7"
                android:textSize="16sp" />

            <!-- Refresh Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:text="Refresh"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#6C5CE7"
                app:cornerRadius="30dp" />

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:text="Logout"
                android:textColor="#B85285"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:strokeColor="#B85285"
                app:strokeWidth="2dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
