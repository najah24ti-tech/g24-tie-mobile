<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6"
    tools:context=".Home.HomeFragment">

    <!-- Background Header Wave -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Toolbar dengan teks judul warna putih -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="Home"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Selamat Datang!"
        android:textColor="#6C5CE7"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/background_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Pertemuan 4 -->
    <Button
        android:id="@+id/btnToFourth"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#6C5CE7"
        android:text="Pertemuan 4"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Pertemuan 5 -->
    <Button
        android:id="@+id/btnToFifth"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#8E7CC3"
        android:text="Pertemuan 5"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnToFourth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Pertemuan 7 -->
    <Button
        android:id="@+id/btnToSeventh"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#B85285"
        android:text="Pertemuan 7"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnToFifth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Pertemuan 10 -->
    <Button
        android:id="@+id/btnToTenth"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#D16B98"
        android:text="Pertemuan 10"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnToSeventh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Logout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="28dp"
        android:text="Logout"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="#E53935"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnToTenth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>