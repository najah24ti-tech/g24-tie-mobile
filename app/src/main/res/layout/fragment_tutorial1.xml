<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    tools:context=".Message.tutorial.Tutorial1Fragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_dialog_email"
            android:backgroundTint="#D16B98"
            android:contentDescription="Ikon pesan"
            android:padding="35dp"
            android:background="#F8BBD0"
            android:elevation="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Selamat Datang di Ruang Pesan!"
            android:textColor="#AD527A"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mulai percakapan dengan mudah dan tetap terhubung dengan teman, keluarga, maupun orang-orang terdekatmu."
            android:textColor="#79515F"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</FrameLayout>