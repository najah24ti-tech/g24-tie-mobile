<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSeventh"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#6750A4"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Pertemuan 7"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Fragment 1 -->
    <Button
        android:id="@+id/btnFragment1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="4dp"
        android:text="Fragment 1"
        app:layout_constraintTop_toBottomOf="@id/toolbarSeventh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnFragment2"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <!-- Tombol Fragment 2 -->
    <Button
        android:id="@+id/btnFragment2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="4dp"
        android:text="Fragment 2"
        app:layout_constraintTop_toBottomOf="@id/toolbarSeventh"
        app:layout_constraintStart_toEndOf="@id/btnFragment1"
        app:layout_constraintEnd_toStartOf="@id/btnFragment3" />

    <!-- Tombol Fragment 3 -->
    <Button
        android:id="@+id/btnFragment3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:text="Fragment 3"
        app:layout_constraintTop_toBottomOf="@id/toolbarSeventh"
        app:layout_constraintStart_toEndOf="@id/btnFragment2"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tempat menampilkan Fragment -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnFragment1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>