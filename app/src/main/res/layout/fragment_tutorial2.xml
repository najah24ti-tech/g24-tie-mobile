<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE7F6"
    tools:context=".Message.tutorial.Tutorial2Fragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_dialog_info"
            android:contentDescription="Ikon informasi"
            android:padding="35dp"
            android:background="#D1C4E9"
            android:elevation="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="Percakapan Jadi Lebih Praktis"
            android:textColor="#725B91"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kirim dan terima pesan dengan cepat. Temukan semua percakapan dalam satu tempat tanpa kesulitan."
            android:textColor="#655578"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</FrameLayout>